{
  "collectionName": "components_banners_promotion_banners",
  "info": {
    "displayName": "Promotion Banner"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::tiptap-editor.RichText",
      "options": {
        "preset": "richTextSection"
      }
    },
    "desktopBgImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "btnText": {
      "type": "string"
    },
    "btnLink": {
      "type": "string"
    },
    "mobileBgImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "tabBgImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "disclaimer": {
      "type": "string"
    },
    "contentAlignment": {
      "type": "enumeration",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    },
    "links": {
      "type": "component",
      "component": "content-blocks.chip-link",
      "repeatable": true
    }
  },
  "config": {}
}
